{
  "mcpServers": {
    "google-ads": {
      "command": "pipx",
      "args": ["run", "--spec", "git+https://github.com/googleads/google-ads-mcp.git@44ca7770519362c8f334875477e1ceb499f8d2dd", "google-ads-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_CLOUD_PROJECT": "${GOOGLE_CLOUD_PROJECT}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID:-}",
        "GOOGLE_ADS_MCP_TOOLS_CONFIG": "google-ads-mcp/tools_config.yaml"
      }
    },
    "apply": {
      "command": "uv",
      "args": ["run", "--quiet", "python", "-m", "apply.server"]
    }
  }
}
