{
  "about": "Repos we built the Ads agents, skills and Apply connector from. scripts/upstream_sync.py checks each one weekly (or every 'every_days') and opens a PR when a watched file changed. 'watch' = upstream paths we care about. 'ours' = our files that came from it. 'pinned' = the upstream commit our copy matches; only the script moves it. 'pin_in' = config files that run that exact commit. How it works: upstream/README.md.",
  "reports": "upstream/reports",
  "sources": [
    {
      "id": "google-ads-mcp",
      "repo": "googleads/google-ads-mcp",
      "branch": "main",
      "every_days": 7,
      "watch": [
        "ads_mcp/",
        "README.md",
        "docs/",
        "pyproject.toml"
      ],
      "ours": [
        ".mcp.json",
        "google-ads-mcp/tools_config.yaml",
        ".claude/agents/analyst.md",
        ".claude/hooks/guard.py"
      ],
      "why": "Google's MCP server that READS the account. .mcp.json runs it at the pinned commit, so a new tool (some change the account) can never appear without this review. The guard hook allows only its three read tools.",
      "pin_in": [
        ".mcp.json"
      ],
      "license": "Apache-2.0",
      "pinned": {
        "sha": "44ca7770519362c8f334875477e1ceb499f8d2dd",
        "date": "2026-11-17T15:02:48Z"
      }
